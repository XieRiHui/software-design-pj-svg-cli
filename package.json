{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "svg-editor": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-plugin-manifests.mjs",
    "metrics": "node scripts/generate-metrics.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
